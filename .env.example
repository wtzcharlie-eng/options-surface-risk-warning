# 默认为本地证据解读，不向外发送风险快照。
# 复制为项目根目录 .env 后，预测工作台和快照命令会加载；系统环境变量优先。
RISK_LLM_PROVIDER=local

# 云端服务：明确切换为 openai 或 openai-compatible，并填入实际可用模型及密钥。
# RISK_LLM_PROVIDER=openai-compatible
# RISK_LLM_BASE_URL=https://api.openai.com/v1
# RISK_LLM_MODEL=
# RISK_LLM_API_KEY=
RISK_LLM_TIMEOUT_SECONDS=30

# 本地兼容服务：显式选择 local-openai，仅允许本机回环地址且可不填密钥。
# RISK_LLM_PROVIDER=local-openai
# RISK_LLM_BASE_URL=http://127.0.0.1:11434/v1
# RISK_LLM_MODEL=
# RISK_LLM_API_KEY=

# 同时支持 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL 作为名称回退。
# 云端模式会向所配置的服务商发送当前风险证据与最近对话，请只传入允许分享的数据。
